# Sanad settings. NOTHING here is required: `docker compose up` works without a .env file.
# To change a value: copy this file to `.env` (next to docker-compose.yml) and edit it.
# Never commit .env. Empty values mean "use the default".
#
# إعدادات منصة سند. لا شيء هنا إلزامي: التشغيل يعمل بدون ملف .env.
# لتغيير قيمة: انسخ هذا الملف باسم .env بجانب docker-compose.yml وعدّله. لا ترفع .env للمستودع.

# ---------------------------------------------------------------------------
# Ports on your computer / المنافذ على جهازك
# ---------------------------------------------------------------------------
# the platform: http://localhost:3000
WEB_PORT=3000
# local mailbox (emails sent by the platform): http://localhost:8025
MAILPIT_PORT=8025

# Address people use to open the platform (used in email links).
# For other devices on your network use http://<your-PC-IP>:3000
PUBLIC_URL=http://localhost:3000
# "true" when served over HTTPS (default: true only if PUBLIC_URL starts with https://)
COOKIE_SECURE=

# ---------------------------------------------------------------------------
# System admin account (username "admin") / حساب المدير الأساسي
# ---------------------------------------------------------------------------
# used only when the account is first created
ADMIN_EMAIL=jbahmaid@gmail.com
# Leave empty: a temporary password is generated, printed in `docker compose logs api` and saved
# in the container (docker compose exec api cat /app/secrets/admin-initial-password.txt).
# If set: at least 12 characters. Either way it must be changed at first login.
ADMIN_PASSWORD=
# Forgot the admin password? Set to true, run `docker compose up -d`, read the new temporary
# password from the logs, then set it back to false.
ADMIN_RESET_PASSWORD=false
# apply reference data (countries, lookups) on every start; safe to repeat
SEED_ON_START=true
# add the sample tribe lineage data on first seed
SEED_SAMPLE_TRIBE_DATA=true

# ---------------------------------------------------------------------------
# Database (PostgreSQL inside docker) / قاعدة البيانات
# ---------------------------------------------------------------------------
POSTGRES_USER=sanad
POSTGRES_PASSWORD=sanad-local-only
POSTGRES_DB=sanad
# The API builds DATABASE_URL from the three values above. Outside docker set it directly:
# DATABASE_URL=postgresql://sanad:sanad-local-only@localhost:5432/sanad?schema=public
# REDIS_URL=redis://localhost:6379
# API port inside its container
# PORT=4000

# ---------------------------------------------------------------------------
# Secret keys / المفاتيح السرية
# ---------------------------------------------------------------------------
# Leave empty: generated on first start and kept in the "secrets" docker volume
# (/app/secrets/keys.json). Set them only to move an installation to another server.
# NEVER change ID_ENCRYPTION_KEY / ID_HASH_KEY on a running installation: stored ID numbers
# could no longer be read or matched.
# 64 hex characters (AES-256-GCM for ID numbers)
ID_ENCRYPTION_KEY=
# 64 hex characters (HMAC for ID-number uniqueness)
ID_HASH_KEY=
# 32+ characters
JWT_ACCESS_SECRET=
# 32+ characters
JWT_REFRESH_SECRET=
# SECRETS_FILE=/app/secrets/keys.json
# ADMIN_PASSWORD_FILE=/app/secrets/admin-initial-password.txt

# Sessions
# 15 minutes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Email / البريد
# ---------------------------------------------------------------------------
# Default: Mailpit (catches every email locally, nothing leaves your computer).
# For real delivery put your provider's SMTP settings here.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sanad <no-reply@sanad.local>

# ---------------------------------------------------------------------------
# SMS (disabled by default) / الرسائل النصية (معطلة افتراضياً)
# ---------------------------------------------------------------------------
SMS_ENABLED=false
# "log" only writes the message to the worker log (no real provider yet)
SMS_PROVIDER=log

# ---------------------------------------------------------------------------
# CV analysis (disabled by default) / تحليل السير الذاتية (معطل افتراضياً)
# ---------------------------------------------------------------------------
CV_ANALYSIS_ENABLED=false
CV_ANALYSIS_MODEL=claude-opus-5-5
# required only when CV_ANALYSIS_ENABLED=true
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# File storage for CVs (MinIO, S3 compatible) / تخزين ملفات السير
# ---------------------------------------------------------------------------
# S3_ENDPOINT=http://minio:9000   # fixed inside docker
S3_BUCKET=cvs
S3_ACCESS_KEY=sanad
S3_SECRET_KEY=sanad-local-only
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# request rate limits (keep true)
THROTTLE_ENABLED=true
# "debug" shows framework start-up details
LOG_LEVEL=log
