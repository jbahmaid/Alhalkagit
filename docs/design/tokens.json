{
  "$meta": {
    "name": "Sanad design tokens",
    "version": "0.1.0",
    "status": "provisional: initial visual identity, the project owner will refine it",
    "usage": "Map color.light/color.dark to CSS variables on :root and on the dark-mode selector, then point Tailwind theme.extend.colors at var(--color-*). Spacing, radius and fontSize map directly to theme.extend."
  },
  "color": {
    "light": {
      "bg": "#F6F5F1",
      "surface": "#FFFFFF",
      "surface-2": "#EFEDE6",
      "border": "#D9D6CC",
      "text": "#1B2421",
      "text-muted": "#56615C",
      "primary": "#0E5E58",
      "primary-hover": "#0A4A45",
      "primary-soft": "#E2F0EE",
      "on-primary": "#FFFFFF",
      "accent": "#9A6212",
      "accent-soft": "#F6ECDC",
      "match": "#156A3A",
      "match-soft": "#E3F3E8",
      "near": "#8A4B00",
      "near-soft": "#FBEFD9",
      "danger": "#B42318",
      "danger-soft": "#FDECEA",
      "info": "#1F5C99",
      "info-soft": "#E6EFF8",
      "focus": "#0B66C3"
    },
    "dark": {
      "bg": "#0E1412",
      "surface": "#161F1C",
      "surface-2": "#1E2926",
      "border": "#2D3A36",
      "text": "#E6ECE9",
      "text-muted": "#A2B0AA",
      "primary": "#5CC2B6",
      "primary-hover": "#7AD3C8",
      "primary-soft": "#15332F",
      "on-primary": "#06201D",
      "accent": "#E0B062",
      "accent-soft": "#33281A",
      "match": "#7BD49C",
      "match-soft": "#133222",
      "near": "#F2B766",
      "near-soft": "#3A2A12",
      "danger": "#FF8A80",
      "danger-soft": "#3A1714",
      "info": "#8DBBEE",
      "info-soft": "#142638",
      "focus": "#7DB3FF"
    },
    "roles": {
      "primary": "Main actions, links, active navigation, brand mark",
      "accent": "Sparing brand highlight (logo detail, section eyebrow). Never for status",
      "match": "Badge for a 'suitable' job (score >= 70). Always paired with a check icon and the word",
      "near": "Badge for a 'near match' job (score 45-69) and pending states. Always paired with an icon and the word",
      "danger": "Errors, destructive actions, rejected",
      "info": "Neutral notices (e.g. 'available when activated')",
      "focus": "2px focus ring on every interactive element"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": ["IBM Plex Sans Arabic", "system-ui", "-apple-system", "Segoe UI", "Tahoma", "sans-serif"]
    },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap",
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "fontSize": {
      "xs": ["12px", { "lineHeight": "1.5" }],
      "sm": ["14px", { "lineHeight": "1.6" }],
      "base": ["16px", { "lineHeight": "1.7" }],
      "lg": ["18px", { "lineHeight": "1.6" }],
      "xl": ["20px", { "lineHeight": "1.4" }],
      "2xl": ["24px", { "lineHeight": "1.35" }],
      "3xl": ["30px", { "lineHeight": "1.3" }],
      "4xl": ["36px", { "lineHeight": "1.25" }]
    },
    "notes": "Inputs are never smaller than 16px (prevents iOS zoom). Arabic body text needs line-height >= 1.6."
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(16, 24, 22, 0.06)",
    "md": "0 4px 16px rgba(16, 24, 22, 0.08)"
  },
  "size": {
    "touchTarget": "44px",
    "containerMax": "1120px",
    "formMax": "640px",
    "pageGutterMobile": "16px",
    "pageGutterDesktop": "24px"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px"
  }
}
